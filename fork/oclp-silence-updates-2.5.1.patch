+    "MacBookAir2,1": "10.11 El Capitan", "MacBookAir3,1": "10.11 El Capitan",
+    "MacBookAir3,2": "10.11 El Capitan",
+    "MacBookAir4,1": "10.11 El Capitan", "MacBookAir4,2": "10.11 El Capitan",
+    "MacBookAir5,1": "10.15 Catalina", "MacBookAir5,2": "10.15 Catalina",
+    "MacBookAir6,1": "11 Big Sur", "MacBookAir6,2": "11 Big Sur",
+    "MacBookAir7,1": "11 Big Sur", "MacBookAir7,2": "13 Ventura",
+    "MacBookPro4,1": "10.11 El Capitan", "MacBookPro5,1": "10.11 El Capitan",
+    "MacBookPro5,2": "10.11 El Capitan", "MacBookPro5,3": "10.11 El Capitan",
+    "MacBookPro5,4": "10.11 El Capitan", "MacBookPro5,5": "10.11 El Capitan",
+    "MacBookPro6,1": "10.13 High Sierra", "MacBookPro6,2": "10.13 High Sierra",
+    "MacBookPro7,1": "10.13 High Sierra", "MacBookPro8,1": "10.13 High Sierra",
+    "MacBookPro8,2": "10.13 High Sierra", "MacBookPro8,3": "10.13 High Sierra",
+    "MacBookPro9,1": "10.15 Catalina", "MacBookPro9,2": "10.15 Catalina",
+    "MacBookPro10,1": "10.15 Catalina", "MacBookPro10,2": "10.15 Catalina",
+    "MacBookPro11,1": "11 Big Sur", "MacBookPro11,2": "11 Big Sur",
