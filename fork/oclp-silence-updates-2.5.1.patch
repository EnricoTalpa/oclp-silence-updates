+"""
+gui_silence_updates.py: Generate GUI for silencing macOS update notifications
+
+Custom fork addition (strada C — companion OCLP, progetto PyLab
+"Resetta Aggiornamenti macOS"): su Mac che boota via OpenCore
+(hardware non supportato ufficialmente), il badge "1" di aggiornamento
+in Impostazioni di Sistema è una trappola per utenti non esperti.
+Questa finestra mostra il motivo, lo stato, e consente di silenziare
+(o ripristinare) le notifiche tramite il companion
+resetta_aggiornamenti_bash.sh (v8) installato con privilegi admin.
+
+Riferimenti:
+  - Companion: Resetta-Aggiornamenti/resetta_aggiornamenti_bash.sh (in app)
+  - Installato in: /Library/Application Support/Resetta Aggiornamenti/
+"""
+
+import os
+import wx
+import logging
+import sqlite3
+import plistlib
+import subprocess
+
+from typing import Optional
+from pathlib import Path
+
+from .. import constants
+
+from ..wx_gui import gui_support
+
+
+# Percorsi del companion (v8)
+OC_NVRAM_GUID = "4D1FDA02-38C7-4A6A-9CC6-4BCCA8B30102"
+RESETTA_DIR = "/Library/Application Support/Resetta Aggiornamenti"
+RESETTA_SCRIPT = f"{RESETTA_DIR}/resetta_aggiornamenti_bash.sh"
+DAEMON_LABEL = "it.enrico.resetta-aggiornamenti"
+DAEMON_PLIST = f"/Library/LaunchDaemons/{DAEMON_LABEL}.plist"
+
+# Ultimo macOS ufficiale per modello (tabella v8, indice per hw.model)
+MAX_MACOS_TABLE = {
+    "Macmini3,1": "10.7 Lion",
+    "Macmini4,1": "10.13 High Sierra", "Macmini5,1": "10.13 High Sierra",
+    "Macmini5,2": "10.13 High Sierra", "Macmini5,3": "10.13 High Sierra",
+    "Macmini6,1": "10.15 Catalina", "Macmini6,2": "10.15 Catalina",
+    "Macmini7,1": "12 Monterey",
+    "MacBook4,1": "10.11 El Capitan", "MacBook5,1": "10.11 El Capitan",
+    "MacBook5,2": "10.11 El Capitan", "MacBook6,1": "10.11 El Capitan",
